const int analogPin = A0;  
int sensorValue = 0;

void setup() {
  Serial.begin(9600);
}

void loop() {
    sensorValue = analogRead(analogPin);
    Serial.print("sensorValue ");
    Serial.print("\t"); //delimit ["\t", "," IF "," THEN // "sensorValue]
    Serial.println(sensorValue);
  delay(10);        
}
